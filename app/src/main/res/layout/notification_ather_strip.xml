<?xml version="1.0" encoding="utf-8"?>
<!--
    الإشعار المصغّر (المطوي) لأثير: خلفية كونية + شريط أكسنت علوي خافت +
    غلاف الكتاب + عنوان/الفصل + زر تشغيل/إيقاف + شريط تقدّم ملوّن باللهجة.
    الألوان النهائية تُضبط في AtherMediaNotificationProvider وفق الوضع (فاتح/داكن/AMOLED).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ather_strip_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="locale"
    android:orientation="vertical"
    android:background="#0B0F24">

    <LinearLayout
        android:id="@+id/ather_strip_bar"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:orientation="vertical"
        android:background="#3B82F6" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <ImageView
            android:id="@+id/ather_strip_cover"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_notif_cover"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/ather_strip_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="#EDF2FF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ather_strip_chapter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="#A9B2CC"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/ather_strip_back15"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="@null"
            android:scaleType="centerInside" />

        <ImageButton
            android:id="@+id/ather_strip_play"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:contentDescription="@null"
            android:scaleType="centerInside" />

        <ImageButton
            android:id="@+id/ather_strip_fwd15"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="@null"
            android:scaleType="centerInside" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/ather_strip_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/notif_progress"
        android:indeterminate="false" />
</LinearLayout>